From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mariano Scazzariello <marianoscazzariello@gmail.com>
Date: Thu, 22 Oct 2026 21:05:25 +0200
Subject: [PATCH] CPU image: build TENT with its metrics

---
 docker/Dockerfile.cpu | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/docker/Dockerfile.cpu b/docker/Dockerfile.cpu
index fec7b5c..4f2069f 100644
--- a/docker/Dockerfile.cpu
+++ b/docker/Dockerfile.cpu
@@ -488,7 +488,10 @@ RUN git init -q /src/mooncake && cd /src/mooncake && \
         -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/mooncake \
         -DBUILD_SHARED_LIBS=ON -DWITH_TE=ON -DWITH_STORE=OFF -DWITH_STORE_RUST=OFF \
         -DBUILD_UNIT_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARK=OFF \
-        -DUSE_TCP=ON -DUSE_TENT=ON && \
+        -DUSE_TCP=ON -DUSE_TENT=ON \
+        # TENT's own metrics (per-transport READ latency, size and stage
+        # histograms), served over HTTP when TENT_METRICS_HTTP_PORT is reachable.
+        -DTENT_METRICS_ENABLED=ON && \
     ninja -C /tmp/mooncake-build -j "${max_jobs}" && \
     ninja -C /tmp/mooncake-build install && \
     # NIXL's Mooncake plugin finds libtransfer_engine and its header on the default paths.
