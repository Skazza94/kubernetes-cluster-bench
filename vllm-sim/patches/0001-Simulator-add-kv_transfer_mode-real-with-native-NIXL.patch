 vllm/config/simulation.py                     |  78 +++++++++
 vllm/v1/worker/simulated/model_runner.py      |  28 +++-
 3 files changed, 259 insertions(+), 2 deletions(-)
 create mode 100644 tests/v1/worker/simulated/test_real_kv_transfer.py

diff --git a/tests/v1/worker/simulated/test_real_kv_transfer.py b/tests/v1/worker/simulated/test_real_kv_transfer.py
new file mode 100644
index 0000000..9ece677
--- /dev/null
+++ b/tests/v1/worker/simulated/test_real_kv_transfer.py
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Configuration of real NIXL KV transfers under simulated compute."""
+
+import json
+
+import pytest
+
+from vllm.platforms import current_platform
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cpu(), reason="Real KV transfers start with CPU buffers."
+)
+
+SIMULATED_NIXL = "vllm.v1.worker.simulated.kv_nixl"
+SIMULATED_WORKER = "vllm.v1.worker.simulated.worker.SimulatedWorker"
+
+
+@pytest.fixture(scope="module")
+def model_dir(tmp_path_factory):
+    """A tiny dense Llama configuration: no weights or tokenizer are needed."""
+    directory = tmp_path_factory.mktemp("tiny-llama")
+    (directory / "config.json").write_text(
+        json.dumps(
+            {
+                "architectures": ["LlamaForCausalLM"],
+                "model_type": "llama",
+                "vocab_size": 128,
+                "hidden_size": 256,
+                "intermediate_size": 512,
+                "num_hidden_layers": 2,
+                "num_attention_heads": 2,
+                "num_key_value_heads": 2,
+                "max_position_embeddings": 256,
+                "torch_dtype": "float32",
+            }
+        )
+    )
+    return str(directory)
+
+
+def engine_config(model_dir, simulation=None, kv_transfer=None, **kwargs):
+    from vllm.engine.arg_utils import EngineArgs
+
+    options = {
+        "model": model_dir,
+        "skip_tokenizer_init": True,
+        "dtype": "float32",
+        "max_model_len": 256,
+        "block_size": 32,
+        "kv_cache_memory_bytes": 8 * 1024**2,
+        "enable_prefix_caching": False,
+        "enforce_eager": True,
+        "simulation_config": {
+            "simulate_forward": True,
+            "kv_transfer_mode": "real",
+            **(simulation or {}),
+        },
+        "kv_transfer_config": {
+            "kv_connector": "NixlConnector",
+            "kv_role": "kv_consumer",
+            "kv_buffer_device": "cpu",
+            **(kv_transfer or {}),
+        },
+    }
+    options.update(kwargs)
+    return EngineArgs(**options).create_engine_config()
+
+
+def test_real_mode_keeps_the_native_connector(model_dir):
+    config = engine_config(model_dir)
+    assert config.simulation_config.kv_transfer_mode == "real"
+    assert config.kv_transfer_config.kv_connector == "NixlConnector"
+    # No module path: the connector factory resolves the native NIXL connector.
+    assert config.kv_transfer_config.kv_connector_module_path is None
+    assert config.parallel_config.worker_cls == SIMULATED_WORKER
+
+
+def test_simulated_mode_is_the_default_and_unchanged(model_dir):
+    config = engine_config(
+        model_dir,
+        simulation={"kv_transfer_mode": "simulated", "kv_transfer_timing": None},
+    )
+    assert config.kv_transfer_config.kv_connector_module_path == SIMULATED_NIXL
+    from vllm.config.simulation import SimulationConfig
+
+    assert SimulationConfig().kv_transfer_mode == "simulated"
+
+
+@pytest.mark.parametrize(
+    "simulation, kv_transfer, kwargs, error",
+    [
+        ({}, {"kv_connector": "NixlPushConnector"}, {}, "pull-mode NixlConnector"),
+        (
+            {},
+            {"kv_connector_module_path": SIMULATED_NIXL},
+            {},
+            "without kv_connector_module_path",
+        ),
+        ({}, {"kv_buffer_device": "cuda"}, {}, "CPU KV buffers"),
+        ({"kv_transfer_timing": {"load_gbps": 1}}, {}, {}, "no kv_transfer_timing"),
+        ({}, {}, {"kv_cache_memory_bytes": None}, "explicit kv_cache_memory_bytes"),
+        ({}, {}, {"enable_prefix_caching": True}, "prefix caching disabled"),
+        ({"clock": "virtual"}, {}, {}, "the real clock"),
+    ],
+)
+def test_real_mode_rejections(model_dir, simulation, kv_transfer, kwargs, error):
+    with pytest.raises(ValueError, match=error):
+        engine_config(model_dir, simulation, kv_transfer, **kwargs)
+
+
+def test_real_mode_needs_a_connector(model_dir):
+    with pytest.raises(ValueError, match="needs a kv_transfer_config"):
+        engine_config(model_dir, kv_transfer_config=None)
+
+
+@pytest.mark.parametrize("real", [True, False])
+def test_runner_uses_native_kv_tensors_only_in_real_mode(monkeypatch, real):
+    """Real mode allocates and registers KV tensors, zeroes new blocks and
+    applies copy-on-write through the native runner; simulated mode does none."""
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+    from vllm.v1.worker.simulated.model_runner import SimulatedModelRunner
+
+    calls = []
+    for name in (
+        "initialize_kv_cache_tensors",
+        "_init_kv_zero_meta",
+        "_apply_kv_cache_memory_updates",
+    ):
+        monkeypatch.setattr(
+            GPUModelRunner,
+            name,
+            lambda self, *args, _name=name, **kwargs: calls.append(_name),
+        )
+    runner = object.__new__(SimulatedModelRunner)
+    runner._real_kv_transfer = real
+    runner.kv_cache_config = type("Config", (), {"kv_cache_groups": [], "num_blocks": 0})
+    runner.kv_caches = []
+    runner.device = "cpu"
+    monkeypatch.setattr(
+        "vllm.v1.worker.simulated.model_runner.has_kv_transfer_group", lambda: False
+    )
+    runner.initialize_kv_cache_tensors(
+        is_profiling=False, kv_cache_allocation_context=None
+    )
+    runner._init_kv_zero_meta()
+    runner._apply_kv_cache_memory_updates(None)
+    if real:
+        assert calls == [
+            "initialize_kv_cache_tensors",
+            "_init_kv_zero_meta",
+            "_apply_kv_cache_memory_updates",
+        ]
+    else:
+        assert calls == [] and runner.kv_caches == []
diff --git a/vllm/config/simulation.py b/vllm/config/simulation.py
index cb0f5d9..42c272c 100644
--- a/vllm/config/simulation.py
+++ b/vllm/config/simulation.py
@@ -79,6 +79,12 @@ class SimulationConfig:
     """Simulated KV transfer timing, or a step log recorded with the
     connector to fit it from."""
 
+    kv_transfer_mode: Literal["simulated", "real"] = "simulated"
+    """`simulated`: the NIXL connector's worker side is modeled and moves no
+    data; `kv_transfer_timing` gives the transfer times. `real`: the native
+    NIXL connector registers real KV cache tensors and moves them between
+    instances, while compute stays simulated."""
+
     fallback_token_id: int = Field(default=0, ge=0)
     """Output token of requests without `trace_decode_token_ids`."""
 
@@ -148,6 +154,11 @@ class SimulationConfig:
     def _verify_kv_transfer(self, vllm_config: "VllmConfig") -> None:
         kv_transfer = vllm_config.kv_transfer_config
         if kv_transfer is None:
+            if self.kv_transfer_mode == "real":
+                raise ValueError(
+                    "kv_transfer_mode real needs a kv_transfer_config with the "
+                    "NixlConnector."
+                )
             return
         from vllm.v1.kv_offload.cpu.spec import CPUOffloadingSpec
         from vllm.v1.kv_offload.factory import OffloadingSpecFactory
@@ -184,6 +195,9 @@ class SimulationConfig:
             raise ValueError(
                 f"Simulated {connector} does not support the {self.clock} clock."
             )
+        if self.kv_transfer_mode == "real":
+            self._verify_real_kv_transfer(vllm_config)
+            return
         module_path = kv_transfer.kv_connector_module_path
         if module_path not in (None, kv_nixl.__name__):
             raise ValueError(
@@ -191,3 +205,67 @@ class SimulationConfig:
                 f"kv_connector_module_path {module_path} cannot be set."
             )
         kv_transfer.kv_connector_module_path = kv_nixl.__name__
+
+    def _verify_real_kv_transfer(self, vllm_config: "VllmConfig") -> None:
+        """Check what real NIXL transfers under simulated compute support so
+        far: pull transfers of CPU KV buffers, between single-rank instances of
+        a dense full-attention model. The native connector stays in place."""
+        from vllm.platforms import current_platform
+
+        kv_transfer = vllm_config.kv_transfer_config
+        assert kv_transfer is not None
+        problems = []
+        if kv_transfer.kv_connector not in ("NixlConnector", "NixlPullConnector"):
+            problems.append(
+                f"the pull-mode NixlConnector, not {kv_transfer.kv_connector}"
+            )
+        if kv_transfer.kv_connector_module_path is not None:
+            problems.append(
+                "the native connector, without kv_connector_module_path "
+                f"({kv_transfer.kv_connector_module_path})"
+            )
+        if not current_platform.is_cpu() or kv_transfer.kv_buffer_device != "cpu":
+            problems.append(
+                "CPU KV buffers (the CPU platform and kv_buffer_device cpu), not "
+                f"{current_platform.device_type} with {kv_transfer.kv_buffer_device}"
+            )
+        if self.clock != "real":
+            problems.append(f"the real clock, not {self.clock}")
+        if self.kv_transfer_timing is not None:
+            problems.append(
+                "no kv_transfer_timing: transfers take their actual time"
+            )
+        cache = vllm_config.cache_config
+        if cache.kv_cache_memory_bytes is None:
+            problems.append("an explicit kv_cache_memory_bytes")
+        if cache.enable_prefix_caching:
+            problems.append("prefix caching disabled")
+        parallel = vllm_config.parallel_config
+        sizes = {
+            "TP": parallel.tensor_parallel_size,
+            "PP": parallel.pipeline_parallel_size,
+            "DP": parallel.data_parallel_size,
+            "PCP": parallel.prefill_context_parallel_size,
+            "DCP": parallel.decode_context_parallel_size,
+        }
+        if any(size != 1 for size in sizes.values()):
+            parallel_sizes = ", ".join(f"{k}={v}" for k, v in sizes.items())
+            problems.append(f"one rank, not {parallel_sizes}")
+        model = vllm_config.model_config
+        if (
+            model.use_mla
+            or model.is_hybrid
+            or model.is_attention_free
+            or model.is_moe
+            or model.get_sliding_window() is not None
+        ):
+            problems.append(
+                "a dense full-attention model (no MLA, hybrid, attention-free, "
+                "MoE or sliding-window models)"
+            )
+        if vllm_config.speculative_config is not None:
+            problems.append("no speculative decoding")
+        if problems:
+            raise ValueError(
+                "kv_transfer_mode real currently needs " + "; ".join(problems) + "."
+            )
diff --git a/vllm/v1/worker/simulated/model_runner.py b/vllm/v1/worker/simulated/model_runner.py
index d62179b..ab9f176 100644
--- a/vllm/v1/worker/simulated/model_runner.py
+++ b/vllm/v1/worker/simulated/model_runner.py
@@ -97,6 +97,9 @@ class SimulatedModelRunner(GPUModelRunner):
         log_path = step_log_path(vllm_config)
         self.step_log = StepLogWriter(log_path) if log_path else None
         self.fallback_token_id = sim.fallback_token_id
+        # Real KV transfers: real KV tensors that the native connector registers
+        # and moves; only compute is simulated.
+        self._real_kv_transfer = sim.kv_transfer_mode == "real"
         self._pending_step: _PendingStep | None = None
         self._step_index = 0
         self._warming_up = False
@@ -136,6 +139,22 @@ class SimulatedModelRunner(GPUModelRunner):
         is_profiling: bool,
         kv_cache_allocation_context: AbstractContextManager | None,
     ) -> None:
+        if self._real_kv_transfer:
+            # The native path allocates the tensors, binds their layouts and
+            # installs the connector that registers their memory for NIXL.
+            super().initialize_kv_cache_tensors(
+                is_profiling=is_profiling,
+                kv_cache_allocation_context=kv_cache_allocation_context,
+            )
+            logger.info(
+                "Initialized real KV cache for KV transfers: %d groups, %d "
+                "blocks, %d tensors on %s.",
+                len(self.kv_cache_config.kv_cache_groups),
+                self.kv_cache_config.num_blocks,
+                len(self.kv_caches),
+                self.device,
+            )
+            return
         self.kv_caches = []
         logger.info(
             "Initialized virtual KV cache: %d groups, %d blocks; no tensors allocated.",
@@ -155,12 +174,17 @@ class SimulatedModelRunner(GPUModelRunner):
             self._kv_transfers = connector.transfers
 
     def _init_kv_zero_meta(self) -> None:
-        """No KV tensors, nothing to zero."""
+        """Without real KV tensors there is nothing to zero."""
+        if self._real_kv_transfer:
+            super()._init_kv_zero_meta()
 
     def _apply_kv_cache_memory_updates(
         self, scheduler_output: "SchedulerOutput"
     ) -> None:
-        """No KV tensors, nothing to update."""
+        """Zero new blocks and apply copy-on-write copies to real KV tensors;
+        without them there is nothing to update."""
+        if self._real_kv_transfer:
+            super()._apply_kv_cache_memory_updates(scheduler_output)
 
     def warming_up_model(self) -> None:
         logger.info("Skipping model warmup under simulated execution.")
