+                events.get("reads_done", ()),  # type: ignore[arg-type]
+                events.get("reads_failed", ()),  # type: ignore[arg-type]
+            )
+        if self._stall_dump_s is not None:
+            faulthandler.cancel_dump_traceback_later()
+            if self._reads_in_flight:
