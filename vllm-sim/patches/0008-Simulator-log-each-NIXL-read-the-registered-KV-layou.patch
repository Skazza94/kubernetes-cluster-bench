+def test_kv_layout_describes_the_registered_blocks():
+    assert kv_layout(caches(), 8, 4, "LBHNC") == {
+        "layers": 2,
+        "num_blocks": 8,
+        "block_size": 4,
+        "layout": "LBHNC",
+        "dtype": "float32",
+        "shape": [8, 2, 4, 8],
+        "block_bytes": 2 * 4 * 8 * 4,
+        "bytes": 2 * 8 * 2 * 4 * 8 * 4,
