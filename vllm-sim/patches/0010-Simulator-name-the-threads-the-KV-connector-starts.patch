From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mariano Scazzariello <marianoscazzariello@gmail.com>
Date: Thu, 22 Oct 2026 21:28:18 +0200
Subject: [PATCH] Simulator: name the threads the KV connector starts

---
 vllm/v1/worker/simulated/model_runner.py | 20 ++++++++++++++++----
 vllm/v1/worker/simulated/worker.py       | 13 +++++++++++++
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/vllm/v1/worker/simulated/model_runner.py b/vllm/v1/worker/simulated/model_runner.py
index 68e5d77..3f3711d 100644
--- a/vllm/v1/worker/simulated/model_runner.py
+++ b/vllm/v1/worker/simulated/model_runner.py
@@ -76,6 +76,10 @@ _WARMUP_PROMPT_LEN = 2
 _PLACEHOLDER_DRAFT = -1
 
 
+# The name logged for native threads started with the KV connector.
+CONNECTOR_THREAD = "native (KV connector: NIXL and its backends)"
+
+
 @dataclass
 class _PendingStep:
     input_batch: InputBatch
@@ -120,6 +124,8 @@ class SimulatedModelRunner(GPUModelRunner):
         self._kv_events_scheduled_at = 0.0
         self._reads_in_flight: set[str] = set()
         self._logged_threads: set[int] = set()
+        # Set by the worker: native threads started with the KV connector.
+        self.connector_threads: set[int] = set()
         # Debugging aid: dump every thread's Python stack when the engine
         # thread has not come back for this long while reads are in flight
         # (a transfer call that blocks the engine).
@@ -500,15 +506,21 @@ class SimulatedModelRunner(GPUModelRunner):
 
     def _log_new_threads(self) -> None:
         """Log Python threads that started since the last step (some start
-        lazily, e.g. on a first handshake); the process's other threads are
-        native (NIXL, its backends, torch)."""
+        lazily, e.g. on a first handshake), and the native threads started
+        with the KV connector; the process's other threads are native too
+        (torch, gloo, ZMQ)."""
         assert self.step_log is not None
         new = {
-            thread.native_id: thread.name
+            tid: CONNECTOR_THREAD
+            for tid in self.connector_threads
+            if tid not in self._logged_threads
+        }
+        new.update(
+            (thread.native_id, thread.name)
             for thread in threading.enumerate()
             if thread.native_id is not None
             and thread.native_id not in self._logged_threads
-        }
+        )
         if new:
             self._logged_threads.update(new)
             self.step_log.write_threads(new, self.clock.now())
diff --git a/vllm/v1/worker/simulated/worker.py b/vllm/v1/worker/simulated/worker.py
index 7573567..5c63f38 100644
--- a/vllm/v1/worker/simulated/worker.py
+++ b/vllm/v1/worker/simulated/worker.py
@@ -3,6 +3,8 @@
 """Worker for simulated execution: no weights, no KV tensors, no forward."""
 
 # ruff: noqa: E402
+import os
+
 import torch
 
 from vllm.platforms import current_platform
@@ -25,6 +27,13 @@ from vllm.v1.worker.worker_base import CompilationTimes
 logger = init_logger(__name__)
 
 
+def _thread_ids() -> set[int]:
+    try:
+        return {int(tid) for tid in os.listdir("/proc/self/task")}
+    except OSError:
+        return set()
+
+
 class SimulatedWorker(Worker):
     """Worker for simulated execution: no weights, no KV tensors, no forward."""
 
@@ -58,9 +67,13 @@ class SimulatedWorker(Worker):
         # Engines simulated in one process (disaggregated instances) each
         # build their own connector, which is a process global.
         kv_transfer_state.set_kv_transfer_group(None)
+        before = _thread_ids()
         super().initialize_from_config(kv_cache_config)
         if kv_transfer_state.has_kv_transfer_group():
             self._kv_connector = kv_transfer_state.get_kv_transfer_group()
+            # Native threads the connector started (NIXL and its backends),
+            # which a profiler cannot tell apart by name.
+            self.model_runner.connector_threads = _thread_ids() - before
 
     def shutdown(self) -> None:
         # Shut down this engine's connector, not the last one built.
